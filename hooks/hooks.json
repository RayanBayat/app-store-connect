{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__asc__.*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/asc_maint.py\" gate",
            "timeout": 10,
            "onFailure": "block",
            "statusMessage": "Checking App Store Connect MCP review date"
          }
        ]
      }
    ]
  }
}
